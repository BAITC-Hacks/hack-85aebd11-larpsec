# demo = offline rules (explicitly NOT AI); llm = real model through Responses API
ANALYSIS_MODE=demo
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=16000
DATA_DIR=./data
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Optional shared API token for a trusted team. Set before exposing beyond localhost.
API_TOKEN=
MAX_UPLOAD_MB=20
MAX_DOCUMENTS=20
MAX_DOCUMENT_CHARS=200000
MAX_COMPARISON_CHARS=400000
# На каждую сторону сравнения отдельно.
MAX_ANALYSIS_FUNCTIONS=1000
# Includes structured functions and supporting excerpts; tune for the chosen model context.
MAX_LLM_INPUT_CHARS=300000
JOB_WORKERS=2
MAX_PENDING_JOBS=10
